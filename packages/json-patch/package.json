{
  "name": "@dossierhq/json-patch",
  "version": "0.2.0",
  "description": "Strict, bounded JSON Patch (RFC 6902) and JSON Pointer (RFC 6901): parse, apply and diff with explicit limits",
  "keywords": [
    "diff",
    "json-patch",
    "json-pointer",
    "patch",
    "rfc6901",
    "rfc6902"
  ],
  "homepage": "https://github.com/dossierhq/json-patch/tree/main/packages/json-patch#readme",
  "bugs": "https://github.com/dossierhq/json-patch/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dossierhq/json-patch.git",
    "directory": "packages/json-patch"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint --deny-warnings && ast-grep scan --error --color=never && ast-grep test --skip-snapshot-tests",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check-types": "tsc --noEmit && tsc -p fuzz",
    "test": "vitest --run --coverage && node ../../scripts/relativize-coverage.ts coverage/coverage-final.json",
    "test:coverage": "vitest --run --coverage",
    "test:watch": "vitest",
    "test:hunt": "node ../../scripts/hunt-properties.ts",
    "mutate": "stryker run",
    "fuzz": "tsc -p tsconfig.build.json && node fuzz/seed-corpus.ts && jazzer fuzz/patch.fuzz.mjs fuzz/corpus --sync -i json-patch/dist/ -- -max_total_time=${FUZZ_SECONDS:-300} -artifact_prefix=fuzz/crashes/",
    "fuzz:replay": "tsc -p tsconfig.build.json && jazzer fuzz/patch.fuzz.mjs --sync -i json-patch/dist/ -- -runs=1"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.45.3",
    "@jazzer.js/core": "^4.0.0",
    "@repo/typescript-config": "workspace:*",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "fast-json-patch": "^3.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
